    "enable_npc_checks": {
      "type": "Toggle",
      "rich_text_doc": true,
      "display_name": "Enable NPC Checks",
      "description": [
        "Enable NPC checks?",
        "",
        "Adds a check for every NPC in the game. This check is performed when",
        "you see the named character speak in any situation."
      ],
      "default": false,
      "group": "Others"
    }
  }
}