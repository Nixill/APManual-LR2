    "weight_grip": {
      "type": "Range",
      "rich_text_doc": true,
      "display_name": "Weight of Grip",
      "description": [
        "Relative weight for generating Grip as a progression item.",
        "",
        "Exactly ten car bonuses must be selected. If you put fewer between",
        "these three options, the remainder will be made up at random."
      ],
      "default": 10,
      "group": "Item Weighting",
      "range_start": 0,
      "range_end": 10
    },
    "weight_shield": {
      "type": "Range",
      "rich_text_doc": true,
      "display_name": "Weight of Shield",
      "description": [
        "Relative weight for generating Shield as a progression item.",
        "",
